#version 450
// Live native composite (port/docs/NATIVE_RENDERER.md §3, §7): for every sample of
// the high-resolution output, take the native sample when the paraLLEl-GS
// pixel under it is owned by the native layer, else the GS pixel.
//   own = 1 (default): exact ownership.  The ownership plane (native_fx.cpp)
//     says, per 1x pixel, that the last write to it came from a native batch
//     (the ownership GS drew native batches in a marker colour).
//   own = 0 (XSG_GPU_NATIVE_OWNER=0, the old rule): the 1x native render
//     covers the pixel and the GS kept the colour it predicts (within thr),
//     and the GS Z is not in front of the native depth.
// Output: colour (alpha = the GS alpha) and the GS-units Z of the composite,
// which the effect replay (native_fx.comp) then draws on.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D hc;   // native colour, scale s
layout(set = 0, binding = 1) uniform sampler2D hd;   // native depth, scale s (0 = nothing drawn)
layout(set = 0, binding = 2) uniform sampler2D lc;   // native colour, 1x
layout(set = 0, binding = 3) uniform sampler2D ld;   // native depth, 1x
layout(std430, set = 0, binding = 4) readonly buffer Gs { uint gs[]; };   // w*h RGBA8, w*h Z, w*h owner
layout(rgba8, set = 0, binding = 5) writeonly uniform image2D o_img;
layout(r32ui, set = 0, binding = 6) writeonly uniform uimage2D o_z;
layout(push_constant) uniform P {
    int w, h, s, thr;   // w, h: the GS frame (1x)
    float zmul;
    int own;
    int mx;             // widescreen: native-only columns each side (1x); the output is (w + 2 mx) * s wide
} p;

void main() {
    ivec2 o = ivec2(gl_GlobalInvocationID.xy);
    if (o.x >= (p.w + 2 * p.mx) * p.s || o.y >= p.h * p.s) return;
    ivec2 g = o / p.s - ivec2(p.mx, 0);
    if (g.x < 0 || g.x >= p.w) {
        // A side band: no GS pixel here, so the native sample unconditionally (black where
        // nothing native is drawn).  Alpha: the nearest GS edge pixel's (destination alpha
        // tests of the effect replay).
        float nd = texelFetch(hd, o, 0).r;
        int ei = g.y * p.w + clamp(g.x, 0, p.w - 1);
        float ea = unpackUnorm4x8(gs[ei]).a;
        imageStore(o_img, o, vec4(nd > 0.0 ? texelFetch(hc, o, 0).rgb : vec3(0.0), ea));
        imageStore(o_z, o, uvec4(nd > 0.0 ? uint(clamp(nd * p.zmul, 0.0, 4294967040.0)) : 0u));
        return;
    }
    int gi = g.y * p.w + g.x;
    vec4 gc = unpackUnorm4x8(gs[gi]);
    uint zg = gs[p.w * p.h + gi];
    vec4 res = gc;
    uint zo = zg;
    float nd = texelFetch(hd, o, 0).r;
    if (nd > 0.0) {
        bool ok;
        if (p.own != 0) {
            ok = gs[2 * p.w * p.h + gi] != 0u;
            // Silhouettes: the ownership plane is per 1x pixel, so a pixel whose centre
            // the GS left to the background is wholly GS, a 1x stair step across the
            // native edge at 4-8x.  Next to a native-owned pixel, take the native sample
            // where the native render covers this sub-pixel and is not behind the GS Z.
            if (!ok) {
                bool edge = false;
                for (int k = 0; k < 4; ++k) {
                    ivec2 n = g + ivec2(k == 0 ? -1 : k == 1 ? 1 : 0, k == 2 ? -1 : k == 3 ? 1 : 0);
                    if (n.x < 0 || n.y < 0 || n.x >= p.w || n.y >= p.h) continue;
                    edge = edge || gs[2 * p.w * p.h + n.y * p.w + n.x] != 0u;
                }
                ok = edge && nd * p.zmul + max(64.0, float(zg) * 2e-4) >= float(zg);
            }
        } else {
            float eps = max(64.0, float(zg) * 2e-4);
            ok = nd * p.zmul + eps >= float(zg);
            float d1 = texelFetch(ld, g + ivec2(p.mx, 0), 0).r;
            if (ok && d1 > 0.0) {
                vec3 dc = abs(texelFetch(lc, g + ivec2(p.mx, 0), 0).rgb - gc.rgb) * 255.0;
                ok = max(dc.r, max(dc.g, dc.b)) <= float(p.thr) + 0.5;
            }
        }
        if (ok) {
            res.rgb = texelFetch(hc, o, 0).rgb;
            zo = uint(clamp(nd * p.zmul, 0.0, 4294967040.0));
        }
    } else if (p.own != 0 && gs[2 * p.w * p.h + gi] != 0u) {
        // A 1x pixel the native layer owns (hair, an alpha-tested cutout) where this
        // sub-sample has no native geometry: the GS pixel holds the 1x cutout's colour,
        // which showed as a blocky low-resolution ghost around the high-resolution edge.
        // Take what lies behind it instead: the nearest GS pixel the native layer does not own.
        vec4 bg = vec4(-1.0);
        float bd = 1e9;
        for (int y = -2; y <= 2; ++y)
            for (int x = -2; x <= 2; ++x) {
                ivec2 n = g + ivec2(x, y);
                if (n.x < 0 || n.y < 0 || n.x >= p.w || n.y >= p.h) continue;
                int ni = n.y * p.w + n.x;
                if (gs[2 * p.w * p.h + ni] != 0u) continue;
                vec2 d = (vec2(n + ivec2(p.mx, 0)) + 0.5) * float(p.s) - (vec2(o) + 0.5);
                float dd = dot(d, d);
                if (dd < bd) { bd = dd; bg = unpackUnorm4x8(gs[ni]); }
            }
        if (bg.a >= 0.0) res.rgb = bg.rgb;
    }
    imageStore(o_img, o, res);
    imageStore(o_z, o, uvec4(zo));
}
