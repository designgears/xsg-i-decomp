#!/bin/sh
# AppRun for the Xenosaga Episode I PC port (port/docs/PACKAGING.md).
#
# The game (usr/bin/xsg) is a 32-bit i386 program.  It runs through the bundled
# 32-bit loader with --library-path, so it needs no 32-bit (multilib) libraries
# on the host and no LD_LIBRARY_PATH is set: the environment the game passes on
# to its child (xsg-gpu) is the user's own.
#
# The loader lives in usr/bin next to xsg on purpose: run this way,
# /proc/self/exe is the loader, and the game finds its renderer as
# "<dir of /proc/self/exe>/gpu/xsg-gpu" (gpu_client.cpp DefaultBin), which is
# usr/bin/gpu/xsg-gpu, the 64-bit side's wrapper.
HERE=${APPDIR:-$(dirname "$(readlink -f "$0")")}
exec "$HERE/usr/bin/ld-linux.so.2" --library-path "$HERE/usr/lib32" --argv0 xsg \
    "$HERE/usr/bin/xsg" "$@"
