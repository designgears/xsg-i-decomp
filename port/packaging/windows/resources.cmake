# xsg_windows_rc(OUT_RC NAME DESCRIPTION): configure port/packaging/windows/xsg.rc.in for one
# executable, with the icon rendered from port/packaging/xsg.svg when ImageMagick is available.
# Used by port/CMakeLists.txt (the stub xsg.exe) and port/gpu/CMakeLists.txt (xsg-gpu.exe).
set(XSG_PKG_WIN_DIR ${CMAKE_CURRENT_LIST_DIR})
find_program(XSG_MAGICK magick)
function(xsg_windows_rc out_rc name description)
  set(ico ${CMAKE_CURRENT_BINARY_DIR}/xsg.ico)
  if(XSG_MAGICK AND NOT EXISTS ${ico})
    execute_process(COMMAND ${XSG_MAGICK} -background none ${XSG_PKG_WIN_DIR}/../xsg.svg
                            -define icon:auto-resize=256,64,48,32,16 ${ico} RESULT_VARIABLE rc)
  endif()
  if(EXISTS ${ico})
    set(XSG_RC_ICON_LINE "1 ICON \"${ico}\"")
  else()
    set(XSG_RC_ICON_LINE "")
  endif()
  find_package(Git QUIET)
  set(v "")
  if(GIT_FOUND)
    execute_process(COMMAND ${GIT_EXECUTABLE} describe --always --dirty --tags
      WORKING_DIRECTORY ${XSG_PKG_WIN_DIR} OUTPUT_VARIABLE v OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  endif()
  string(TIMESTAMP y "%Y")
  string(TIMESTAMP m "%m")
  string(TIMESTAMP d "%d")
  math(EXPR m "${m}")
  math(EXPR d "${d}")
  set(XSG_RC_VERSION_COMMAS "0,${y},${m},${d}")
  set(XSG_RC_VERSION_STRING "0.${y}.${m}.${d} (${v})")
  set(XSG_RC_NAME ${name})
  set(XSG_RC_DESCRIPTION ${description})
  configure_file(${XSG_PKG_WIN_DIR}/xsg.rc.in ${CMAKE_CURRENT_BINARY_DIR}/${name}.rc @ONLY)
  set(${out_rc} ${CMAKE_CURRENT_BINARY_DIR}/${name}.rc PARENT_SCOPE)
endfunction()
