# Cross-compiling for Windows with MinGW-w64 (port/docs/WINDOWS.md).
#   cmake -S port -B port/build-win32 -DCMAKE_TOOLCHAIN_FILE=port/cmake/mingw-i686.cmake     (the game, xsg.exe)
#   cmake -S port/gpu -B port/build-win64 -DCMAKE_TOOLCHAIN_FILE=port/cmake/mingw-x86_64.cmake (xsg-gpu.exe)
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR i686)
set(XSG_MINGW_PREFIX i686-w64-mingw32)
set(CMAKE_C_COMPILER ${XSG_MINGW_PREFIX}-gcc)
set(CMAKE_CXX_COMPILER ${XSG_MINGW_PREFIX}-g++)
set(CMAKE_RC_COMPILER ${XSG_MINGW_PREFIX}-windres)
set(CMAKE_AR ${XSG_MINGW_PREFIX}-ar)
set(CMAKE_RANLIB ${XSG_MINGW_PREFIX}-ranlib)
set(CMAKE_FIND_ROOT_PATH /usr/${XSG_MINGW_PREFIX})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
